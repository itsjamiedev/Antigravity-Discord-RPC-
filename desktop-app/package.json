{
  "name": "antigravity-presence-desktop",
  "productName": "Antigravity Presence",
  "version": "2.2.0",
  "description": "Standalone Windows Desktop Companion, Self-Provisioning Antigravity IDE Extension Installer, Interactive Mascot Pet, Windows Dynamic Notch, and Zero-Lag Discord RPC",
  "main": "main.cjs",
  "author": "itsjamiedev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "installer": "electron . --installer",
    "overlay": "electron . --overlay-only",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "org.itsjamiedev.antigravity-presence",
    "productName": "Antigravity Presence",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "installer.html",
      "overlay.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "../resources/mascot.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antigravity Presence"
    },
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      },
      {
        "from": "../resources",
        "to": "resources"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../readme.md",
        "to": "readme.md"
      },
      {
        "from": "../LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0"
  }
}
