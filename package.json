{
  "name": "antigravity-presence",
  "displayName": "Antigravity Presence",
  "publisher": "itsjamiefied",
  "version": "1.0.0",
  "description": "Privacy-safe Discord Rich Presence and real-time observability dashboard for Google Antigravity IDE & agents",
  "author": "itsjamiefied",
  "license": "MIT",
  "keywords": [
    "antigravity",
    "google-antigravity",
    "discord",
    "rich-presence",
    "rpc",
    "ai-agent",
    "tokens",
    "gemini",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjamiedev/Antigravity-Discord-RPC-.git"
  },
  "bugs": {
    "url": "https://github.com/itsjamiedev/Antigravity-Discord-RPC-/issues"
  },
  "homepage": "https://github.com/itsjamiedev/Antigravity-Discord-RPC-#readme",
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravityPresence.openDashboard",
        "title": "Antigravity Presence: Open Local Dashboard"
      },
      {
        "command": "antigravityPresence.reconnectDiscord",
        "title": "Antigravity Presence: Reconnect Discord"
      },
      {
        "command": "antigravityPresence.togglePresence",
        "title": "Antigravity Presence: Toggle Discord Presence"
      },
      {
        "command": "antigravityPresence.reloadWindow",
        "title": "Antigravity Presence: Reload Extension Host Window"
      }
    ],
    "configuration": {
      "title": "Antigravity Presence",
      "properties": {
        "antigravityPresence.disableRichPresence": {
          "type": "boolean",
          "default": false,
          "description": "Disable Discord Rich Presence"
        },
        "antigravityPresence.enableManualEditsPresence": {
          "type": "boolean",
          "default": true,
          "description": "Display manual file editing activity on Discord when AI agents are idle"
        },
        "antigravityPresence.hideFileNamesInManualEdits": {
          "type": "boolean",
          "default": false,
          "description": "Hide file names in Discord presence when manually editing"
        },
        "antigravityPresence.hideModels": {
          "type": "boolean",
          "default": false,
          "description": "Hide specific AI model names on Discord"
        },
        "antigravityPresence.hideTokens": {
          "type": "boolean",
          "default": true,
          "description": "Hide token counts on Discord (shown in local dashboard)"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/daemon.cjs",
    "dev": "tsx src/daemon/index.ts",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.90.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
