{
  "name": "antigravity-presence",
  "displayName": "Antigravity Presence",
  "publisher": "itsjamiefied",
  "version": "1.0.0",
  "icon": "resources/icon.png",
  "description": "Discord Rich Presence and activity status companion for Google Antigravity",
  "author": "itsjamiefied",
  "license": "MIT",
  "keywords": [
    "antigravity",
    "discord",
    "rich-presence",
    "presence",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjamiedev/Antigravity-Discord-RPC-"
  },
  "bugs": {
    "url": "https://github.com/itsjamiedev/Antigravity-Discord-RPC-/issues"
  },
  "homepage": "https://github.com/itsjamiedev/Antigravity-Discord-RPC-",
  "main": "./dist/extension.cjs",
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravityPresence.openDashboard",
        "title": "Antigravity Presence: Open Dashboard in Browser"
      },
      {
        "command": "antigravityPresence.openDashboardInIde",
        "title": "Antigravity Presence: Open Dashboard in IDE"
      },
      {
        "command": "antigravityPresence.pauseAndLeaveSession",
        "title": "Antigravity Presence: Pause & Leave Session (24h Retention)"
      },
      {
        "command": "antigravityPresence.resumePreviousSession",
        "title": "Antigravity Presence: Resume Previous Session"
      },
      {
        "command": "antigravityPresence.startFreshSession",
        "title": "Antigravity Presence: Start Fresh Session"
      },
      {
        "command": "antigravityPresence.reconnectDiscord",
        "title": "Antigravity Presence: Reconnect Discord"
      },
      {
        "command": "antigravityPresence.togglePresence",
        "title": "Antigravity Presence: Toggle Discord Presence"
      },
      {
        "command": "antigravityPresence.reloadWindow",
        "title": "Antigravity Presence: Reload Extension Host Window"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-presence-sidebar",
          "title": "Antigravity Presence",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-presence-sidebar": [
        {
          "type": "webview",
          "id": "antigravityPresence.sidebarView",
          "name": "Antigravity Activity"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Presence",
      "properties": {
        "antigravityPresence.disableRichPresence": {
          "type": "boolean",
          "default": false,
          "description": "Disable Discord Rich Presence"
        },
        "antigravityPresence.enableManualEditsPresence": {
          "type": "boolean",
          "default": true,
          "description": "Display manual file editing activity on Discord when AI agents are idle"
        },
        "antigravityPresence.hideFileNamesInManualEdits": {
          "type": "boolean",
          "default": false,
          "description": "Hide file names in Discord presence when manually editing"
        },
        "antigravityPresence.hideModels": {
          "type": "boolean",
          "default": false,
          "description": "Hide specific AI model names on Discord"
        },
        "antigravityPresence.hideTokens": {
          "type": "boolean",
          "default": true,
          "description": "Hide AI model token statistics from Discord status"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/daemon.cjs",
    "dev": "tsx src/daemon/index.ts",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.90.0",
    "better-sqlite3": "^13.0.3",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "zod": "^3.24.2"
  }
}
